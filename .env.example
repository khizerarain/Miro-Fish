# Copy to .env.local and fill in.
APP_URL=http://localhost:3000

# --- Database ---
# Postgres connection string (Supabase or Neon). Leave empty to use the embedded
# PGlite database stored in PGLITE_DIR (local development only).
DATABASE_URL=
PGLITE_DIR=.data/pglite

# --- Auth ---
# "local" = built-in email/password (development only). "supabase" = Supabase Auth.
AUTH_PROVIDER=local
# Required for local auth. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Required when AUTH_PROVIDER=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- LLM ---
# true = every screen runs on deterministic mock data, no API credits needed.
MOCK_LLM=true
# Simulated latency for mock responses, so loading states are visible.
MOCK_LLM_DELAY_MS=1200
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5

# --- GitHub App (optional) ---
# Without these the GitHub integration is inert: the webhook returns 503 and no comment is posted.
# Setup steps: docs/GITHUB_APP.md
GITHUB_APP_ID=
# The App's private key (PEM). Literal "\n" escapes are fine on one line. Never commit this.
GITHUB_APP_PRIVATE_KEY=
# The webhook secret you typed into the App settings. Required to accept deliveries.
GITHUB_WEBHOOK_SECRET=
# App slug from https://github.com/apps/<slug> — used for the "Install" button.
GITHUB_APP_SLUG=
